{
  "name": "@kairo/api-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mock": "./src/mock/index.ts",
    "./mock/node": "./src/mock/node.ts"
  },
  "scripts": {
