    "lint": "eslint src"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "ky": "^1.7.0",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
