{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kairo.exchange/json/actor-genesis-v1.schema.json",
  "title": "Kairo ActorGenesis v1",
  "type": "object",
  "required": ["type", "version", "actor_kind", "initial_key", "nonce"],
  "properties": {
    "type": {
      "const": "ActorGenesis"
    },
    "version": {
      "const": 1
    },
    "actor_kind": {
      "type": "string",
      "minLength": 1
    },
    "initial_key": {
      "type": "object",
      "required": ["algorithm", "bytes"],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "bytes": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Raw ed25519 public key bytes encoded with standard base64."
        }
      },
      "additionalProperties": false
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Thirty-two random bytes encoded as lowercase hex."
    }
  },
  "additionalProperties": false
}
