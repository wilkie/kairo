{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kairo.exchange/json/object-version-tag-v1.schema.json",
  "title": "Kairo ObjectVersionTag Statement v1",
  "type": "object",
  "required": ["type", "version", "actor", "subject", "created_at", "body", "signature"],
  "properties": {
    "type": {
      "const": "ObjectVersionTag"
    },
    "version": {
      "const": 1
    },
    "actor": {
      "type": "string",
      "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "subject": {
      "type": "string",
      "pattern": "^object:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Strict RFC 3339 UTC seconds (YYYY-MM-DDTHH:MM:SSZ). No fractional seconds; no offsets other than Z."
    },
    "body": {
      "type": "object",
      "required": ["object", "version", "target", "supersedes"],
      "properties": {
        "object": {
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(\\+[0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*)?$",
          "description": "Strict semver 2.0.0 string. The dependency resolver consumes this; non-semver strings are rejected."
        },
        "target": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$",
              "description": "StatementId of the pointed-at ObjectRevision (a bind)."
            },
            {
              "type": "null",
              "description": "Revocation: this version is withdrawn for the signing actor."
            }
          ]
        },
        "supersedes": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$",
              "description": "StatementId of the prior ObjectVersionTag this one replaces. Must reference a tag from the same actor for the same (object, version)."
            },
            {
              "type": "null",
              "description": "Genesis tag — the first tag for this (actor, object, version). A genesis tag must be a bind (target non-null)."
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "$ref": "statement-envelope-v1.schema.json#/$defs/signature"
    }
  },
  "additionalProperties": false
}
