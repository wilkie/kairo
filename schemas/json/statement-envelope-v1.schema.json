{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kairo.exchange/json/statement-envelope-v1.schema.json",
  "title": "Kairo Statement Envelope v1",
  "type": "object",
  "required": ["type", "version", "created_at", "signature"],
  "properties": {
    "type": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "actor": {
      "type": "string",
      "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "subject": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Strict RFC 3339 UTC seconds (YYYY-MM-DDTHH:MM:SSZ). No fractional seconds; no offsets other than Z."
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "required": ["actor", "key_id", "algorithm", "bytes"],
      "properties": {
        "actor": {
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "description": "Signature algorithm identifier. The MVP algorithm is ed25519."
        },
        "bytes": {
          "type": "string",
          "minLength": 1,
          "contentEncoding": "base64",
          "description": "Raw signature bytes encoded with standard base64."
        }
      },
      "additionalProperties": false
    }
  }
}
