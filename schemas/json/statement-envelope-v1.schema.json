{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kairo.exchange/json/statement-envelope-v1.schema.json",
  "title": "Kairo Statement Envelope v1",
  "type": "object",
  "required": ["type", "version", "signature"],
  "properties": {
    "type": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "actor": {
      "type": "string",
      "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "subject": {
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "required": ["actor", "key_id", "algorithm", "bytes"],
      "properties": {
        "actor": {
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
