{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kairo.exchange/json/source-observation-v1.schema.json",
  "title": "Kairo SourceObservation Statement v1",
  "type": "object",
  "required": ["type", "version", "actor", "subject", "created_at", "previous", "body", "signature"],
  "properties": {
    "type": { "const": "SourceObservation" },
    "version": { "const": 1 },
    "actor": { "type": "string", "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$" },
    "subject": { "type": "string", "pattern": "^object:z[1-9A-HJ-NP-Za-km-z]+$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "previous": {
      "type": "array",
      "items": { "type": "string", "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$" },
      "maxItems": 16,
      "uniqueItems": true
    },
    "body": {
      "type": "object",
      "required": ["source", "url", "refs"],
      "properties": {
        "source": { "type": "string", "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$", "description": "The source object id the URL derives." },
        "url": { "type": "string", "pattern": "^(https|git)://", "description": "The canonical source URL." },
        "refs": {
          "type": "array",
          "description": "Every ref seen, strictly ascending by name.",
          "items": {
            "type": "object",
            "required": ["name", "target"],
            "properties": {
              "name": { "type": "string", "pattern": "^refs/(heads|tags)/.+" },
              "target": { "type": "string", "description": "The object the ref names: a commit, or an annotated tag's tag object.", "pattern": "^git:(sha1:[0-9a-f]{40}|sha256:[0-9a-f]{64})$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "signature": { "$ref": "statement-envelope-v1.schema.json#/$defs/signature" }
  },
  "additionalProperties": false
}
