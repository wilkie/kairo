{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kairo.exchange/json/file-observation-v1.schema.json",
  "title": "Kairo FileObservation Statement v1",
  "type": "object",
  "required": ["type", "version", "actor", "subject", "created_at", "previous", "body", "signature"],
  "properties": {
    "type": { "const": "FileObservation" },
    "version": { "const": 1 },
    "actor": { "type": "string", "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$" },
    "subject": { "type": "string", "pattern": "^object:z[1-9A-HJ-NP-Za-km-z]+$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "previous": {
      "type": "array",
      "items": { "type": "string", "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$" },
      "maxItems": 16,
      "uniqueItems": true
    },
    "body": {
      "type": "object",
      "required": ["source", "url", "sha256", "size"],
      "properties": {
        "source": { "type": "string", "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$", "description": "The file source id the hash derives." },
        "url": { "type": "string", "pattern": "^https?://", "description": "The URL fetched, in normal form; http only for loopback hosts." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "signature": { "$ref": "statement-envelope-v1.schema.json#/$defs/signature" }
  },
  "additionalProperties": false
}
